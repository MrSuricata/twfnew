# ─── Server-Side Variables (Vercel Dashboard) ─────────────────────────
# These are NOT prefixed with VITE_ so they stay server-side only.

# Google Sheets CSV URL (publish sheet as CSV)
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/TU-ID-AQUI/pub?output=csv

# Admin credentials (password stored as SHA-256 hash)
# Generate hash: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
ADMIN_USER=admin
ADMIN_PASS_HASH=sha256-hash-of-your-password

# JWT secret (random 64+ character string)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-secret-here-64-chars-minimum

# Client accounts (JSON array)
# Each client: { email, name, company, clientePattern }
CLIENTS_JSON=[{"email":"cliente@example.com","name":"Juan","company":"Empresa SRL","clientePattern":"EMPRESA"}]

# EmailJS (server-side, for OTP emails)
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_OTP=template_xxxxx
EMAILJS_PUBLIC_KEY=your-public-key

# CORS origin (your production domain)
ALLOWED_ORIGIN=https://your-domain.vercel.app

# ─── DEPRECATED (no longer used) ──────────────────────────────────────
# VITE_ADMIN_USER — moved to ADMIN_USER (server-side)
# VITE_ADMIN_PASS — moved to ADMIN_PASS_HASH (server-side, hashed)
# VITE_GOOGLE_SHEETS_CSV_URL — moved to GOOGLE_SHEETS_CSV_URL (server-side)
