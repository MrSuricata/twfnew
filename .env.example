# ─── Server-Side Variables (Vercel Dashboard) ─────────────────────────
# These are NOT prefixed with VITE_ so they stay server-side only.

# ─── Marca activa (multi-brand: TWF / Mediterránea) ──────────────────
# Selecciona la marca en build-time. Se resuelve así: VITE_BRAND > ?brand=
# (override sticky en localStorage) > hostname > 'twf' por defecto.
# ⚠️ El proyecto de Vercel de Mediterránea DEBE setear VITE_BRAND=med. El
# fallback por hostname solo cubre los dominios listados en src/lib/brand.ts
# (mediterraneacarghas.com.ar/.com, *mediterranea*). Un preview *.vercel.app o un
# dominio nuevo sin VITE_BRAND se sirve como TWF (marca equivocada + preview OG TWF).
# VITE_BRAND también controla el <head> SEO/OG de index.html (plugin brand-index-meta).
# Valores: med | twf. Dejar vacío = twf.
# VITE_BRAND=med

# ─── Fuente de verdad FCL (flip Etapa 4) ─────────────────────────────
# 'db' = la web (tabla shipments source='fcl') es master de las FCL; la Google
# Sheet pasa a export-only y el shipments_cache queda congelado. Está en 'db' en
# producción desde el cutover del flip (16/06/2026). Sacar esta var revierte al
# modelo espejo (el sync re-arma el cache; se perderían ediciones FCL post-flip).
# FCL_SOURCE_OF_TRUTH=db

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co

# SERVER-ONLY key — bypasses RLS.
# NEVER expose this to the browser. Get it from Supabase dashboard →
# Project Settings → API → service_role (SECRET).
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# ─── Google Sheets ───────────────────────────────────────────────────
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/TU-ID-AQUI/pub?output=csv

# ─── Admin credentials ───────────────────────────────────────────────
# Password stored as a bcrypt hash (NOT sha256 — the old format is obsolete).
# Generate: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_USER=admin
ADMIN_PASS_HASH=paste-bcrypt-hash-here

# ─── JWT secret (random 64+ char hex) ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-secret-here-64-chars-minimum

# ─── Cron authentication (mandatory) ─────────────────────────────────
# Required for /api/notifications/check-pending. Vercel auto-adds this as
# Authorization: Bearer $CRON_SECRET on scheduled cron invocations.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=paste-cron-secret-here

# ─── Cloudflare Turnstile (captcha on quote form) ────────────────────
# Create site at https://dash.cloudflare.com → Turnstile. Use "Managed" challenge.
# Both keys are required — secret is server-side, site key is exposed to browser.
TURNSTILE_SECRET_KEY=paste-secret-key-from-cloudflare
VITE_TURNSTILE_SITE_KEY=paste-public-site-key-from-cloudflare

# ─── Client accounts (JSON array) ────────────────────────────────────
# Each client: { email, name, company, clientePattern }
# clientePattern must be ≥5 chars; multiple comma-separated patterns allowed.
CLIENTS_JSON=[{"email":"cliente@example.com","name":"Juan","company":"Empresa SRL","clientePattern":"EMPRESA"}]

# ─── EmailJS (server-side, for OTP + quote emails) ───────────────────
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_OTP=template_xxxxx
EMAILJS_TEMPLATE_QUOTE=template_xxxxx
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key

QUOTE_TO_EMAIL=bridvanovich@twf.uy

# ─── CORS origin (your production domain) ────────────────────────────
ALLOWED_ORIGIN=https://twf.uy

# Base URLs (used by client + server to build absolute URLs, e.g. signature image)
VITE_BASE_URL=https://twf.uy
BASE_URL=https://twf.uy

# Google Analytics 4 measurement ID (client-side, optional)
# Leave empty or commented to disable GA. Placeholder values (G-XXX...) are ignored.
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ─── Supabase Realtime (co-edición de camiones en vivo) ──────────────
# Claves PÚBLICAS por diseño — se incrustan en el bundle del browser. NO son
# secretas → NO marcar "sensitive" en Vercel. Se usan SOLO para conectarse al
# canal Realtime (broadcast/"timbre"): el browser NO lee tablas; la DB sigue
# 100% detrás del backend con SUPABASE_SERVICE_ROLE_KEY. Si faltan, la app
# funciona igual (refresca al volver a la pestaña). OJO: es distinto del
# SUPABASE_ANON_KEY server-side que se removió (ver abajo) — esto es client-side
# y exclusivamente para Realtime, no para acceder a la base.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ─── DEPRECATED / REMOVED ────────────────────────────────────────────
# SUPABASE_ANON_KEY — removed in 2026-04-18 security migration. API now uses
#   SUPABASE_SERVICE_ROLE_KEY exclusively (server-side, bypasses RLS). The anon
#   key is blocked by RLS policies — it's no longer a valid server credential.
# VITE_ADMIN_USER — moved to ADMIN_USER (server-side)
# VITE_ADMIN_PASS — moved to ADMIN_PASS_HASH (server-side, now bcrypt)
# VITE_GOOGLE_SHEETS_CSV_URL — moved to GOOGLE_SHEETS_CSV_URL (server-side)
