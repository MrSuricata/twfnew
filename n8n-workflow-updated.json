{
  "name": "TWF - Enviar Notificación Cliente v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twf-send-notification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst attachments = body.attachments || [];\n\nconst output = {\n  to: body.to,\n  subject: body.subject,\n  htmlBody: body.htmlBody,\n  replyTo: body.replyTo || '',\n  threadId: body.threadId || '',\n  hasAttachments: attachments.length > 0,\n};\n\nconst binaryData = {};\nfor (let i = 0; i < attachments.length; i++) {\n  const att = attachments[i];\n  binaryData[`attachment_${i}`] = {\n    data: att.data,\n    mimeType: att.type || 'application/octet-stream',\n    fileName: att.name || `attachment_${i}`,\n  };\n}\n\nreturn [{ json: output, binary: Object.keys(binaryData).length > 0 ? binaryData : undefined }];"
      },
      "id": "code-1",
      "name": "Procesar Adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.hasAttachments }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Tiene Adjuntos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.htmlBody }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "binaryPropertyName": "={{ Object.keys($binary || {}).filter(k => k.startsWith('attachment_')).join(',') }}"
              }
            ]
          },
          "appendAttribution": false
        }
      },
      "id": "gmail-con-adjuntos",
      "name": "Gmail CON Adjuntos",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [940, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.htmlBody }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-sin-adjuntos",
      "name": "Gmail SIN Adjuntos",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [940, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, messageId: $json.id || '', threadId: $json.threadId || '' }) }}"
      },
      "id": "response-1",
      "name": "Respuesta OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Procesar Adjuntos", "type": "main", "index": 0 }]
      ]
    },
    "Procesar Adjuntos": {
      "main": [
        [{ "node": "Tiene Adjuntos?", "type": "main", "index": 0 }]
      ]
    },
    "Tiene Adjuntos?": {
      "main": [
        [{ "node": "Gmail CON Adjuntos", "type": "main", "index": 0 }],
        [{ "node": "Gmail SIN Adjuntos", "type": "main", "index": 0 }]
      ]
    },
    "Gmail CON Adjuntos": {
      "main": [
        [{ "node": "Respuesta OK", "type": "main", "index": 0 }]
      ]
    },
    "Gmail SIN Adjuntos": {
      "main": [
        [{ "node": "Respuesta OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
