---

export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Button } from '@twf/ui';
---

<BaseLayout title="Página no encontrada · Caro Morales" description="Esta página no existe.">
  <Container size="md" class="min-h-[60vh] flex flex-col justify-center items-center text-center py-20">
    <p class="text-sm uppercase tracking-widest text-[var(--color-primary)] mb-2">404</p>
    <h1 class="font-display text-5xl sm:text-6xl mb-4">Ups, esto no existe.</h1>
    <p class="opacity-70 max-w-md mb-8">No encontramos lo que estabas buscando. ¿Volvemos al inicio?</p>
    <Button as="a" href="/" variant="primary" size="lg">Ir al inicio</Button>
  </Container>
</BaseLayout>
