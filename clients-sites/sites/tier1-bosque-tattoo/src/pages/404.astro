---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Button } from '@twf/ui';
---

<BaseLayout title="Página no encontrada · BOSQUE Tattoo" description="Esta página no existe.">
  <Container size="md" class="min-h-[70vh] flex flex-col justify-center items-center text-center py-20 bg-[#0a0a0a] text-[var(--color-neutral-bg)]">
    <p class="text-sm uppercase tracking-widest text-[var(--color-accent)] mb-3">404</p>
    <h1 class="font-display text-6xl sm:text-7xl mb-4">Esto no está en el bosque.</h1>
    <p class="opacity-70 max-w-md mb-8">No encontramos esa página. Volvé al inicio o escribinos por WhatsApp.</p>
    <Button as="a" href="/" variant="primary" size="lg">Volver al inicio</Button>
  </Container>
</BaseLayout>
