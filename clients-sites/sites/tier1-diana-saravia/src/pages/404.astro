---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Container, Button } from '@twf/ui';
---

<BaseLayout title="Página no encontrada · Diana Saravia" description="Esta página no existe.">
  <Container size="md" class="min-h-[60vh] flex flex-col justify-center items-center text-center py-20">
    <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">404</p>
    <h1 class="font-display text-5xl sm:text-6xl mb-4">Esta obra no está en sala.</h1>
    <p class="opacity-70 max-w-md mb-8">No encontramos la página que buscás. ¿Volvemos al inicio de la galería?</p>
    <Button as="a" href="/" variant="primary" size="lg">Ir al inicio</Button>
  </Container>
</BaseLayout>
