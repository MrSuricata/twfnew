---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  Nav,
  Footer,
  Hero,
  Section,
  Container,
  Button,
  MapEmbed,
  WhatsAppFloat,
  JsonLd,
  Reveal,
  ScrollProgress,
  Marquee,
  Tilt,
  Parallax,
  Magnetic,
} from '@twf/ui';
import { artGallery } from '@twf/lib/schema';
import { buildWhatsAppLink } from '@twf/lib/whatsapp';
import ArtistCard from '@/components/ArtistCard.astro';
import FairsList from '@/components/FairsList.astro';
import VisitForm from '@/components/VisitForm.astro';

const WHATSAPP = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '59899149389';
const WHATSAPP_MSG =
  import.meta.env.PUBLIC_WHATSAPP_DEFAULT_MSG ||
  'Hola Diana, quería visitar la galería / consultar por una obra.';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://dianasaravia.uy';
const waLink = buildWhatsAppLink({ number: WHATSAPP, message: WHATSAPP_MSG });

// {{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} — placeholders sobrios mientras Diana
// confirma la lista definitiva y las imágenes con derechos correspondientes.
// {{PENDIENTE_DERECHOS_DE_IMAGEN_DE_OBRAS}}
const artists: Array<{
  name: string;
  imageUrl: string;
  imageAlt: string;
  representedSince: string;
  discipline: string;
}> = [
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 1',
    imageUrl: '/img/artist-1.svg',
    imageAlt: 'Obra abstracta en óleo, tonos arena y carbón',
    representedSince: '2008',
    discipline: 'Pintura',
  },
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 2',
    imageUrl: '/img/artist-2.svg',
    imageAlt: 'Composición geométrica en bloques de color',
    representedSince: '2011',
    discipline: 'Pintura',
  },
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 3',
    imageUrl: '/img/artist-3.svg',
    imageAlt: 'Obra contemporánea con líneas y campos planos',
    representedSince: '2013',
    discipline: 'Obra sobre papel',
  },
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 4',
    imageUrl: '/img/artist-4.svg',
    imageAlt: 'Composición orgánica con círculos superpuestos',
    representedSince: '2015',
    discipline: 'Pintura',
  },
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 5',
    imageUrl: '/img/artist-5.svg',
    imageAlt: 'Paisaje abstracto en negro y tonos cálidos',
    representedSince: '2017',
    discipline: 'Técnica mixta',
  },
  {
    name: '{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}} · Artista 6',
    imageUrl: '/img/artist-6.svg',
    imageAlt: 'Cuadrícula minimalista en arena, carbón y blanco',
    representedSince: '2019',
    discipline: 'Pintura',
  },
];

// {{VERIFICAR_FECHAS_FERIAS}} — fechas placeholder, confirmar con Diana antes de publicar.
const fairs = [
  {
    city: 'Miami',
    country: 'EE. UU.',
    fair: 'Pinta Miami',
    date: 'Diciembre 2024',
    iconUrl: '/img/fair-miami.svg',
    iconAlt: 'Ícono skyline de Miami',
    note: 'Selección curada de obra sobre papel y pintura contemporánea uruguaya. {{VERIFICAR_FERIA_MIAMI_2024}}',
  },
  {
    city: 'Madrid',
    country: 'España',
    fair: 'ARCOmadrid',
    date: 'Febrero 2025',
    iconUrl: '/img/fair-madrid.svg',
    iconAlt: 'Ícono arquitectura de Madrid',
    note: 'Participación con dos artistas representados de larga trayectoria. {{VERIFICAR_FERIA_MADRID_2025}}',
  },
  {
    city: 'Lima',
    country: 'Perú',
    fair: 'Art Lima',
    date: 'Abril 2025',
    iconUrl: '/img/fair-lima.svg',
    iconAlt: 'Ícono montañas de Lima',
    note: 'Stand de la galería con foco en obra emergente. {{VERIFICAR_FERIA_LIMA_2025}}',
  },
  {
    city: 'Punta del Este',
    country: 'Uruguay',
    fair: 'Este Arte',
    date: 'Enero 2026',
    iconUrl: '/img/fair-puntadeleste.svg',
    iconAlt: 'Ícono mar y vela de Punta del Este',
    note: 'Temporada alta — atendemos a coleccionistas con cita en el stand. {{VERIFICAR_FERIA_PUNTADELESTE_2026}}',
  },
];

const schema = artGallery({
  name: 'Diana Saravia Contemporary Art',
  url: SITE_URL,
  description:
    '20 años seleccionando arte uruguayo contemporáneo en Ciudad Vieja. Representamos a más de 15 artistas locales con trayectoria internacional.',
  telephone: '+59899149389',
  email: 'galeriadianasaravia@gmail.com',
  image: `${SITE_URL}/img/hero.svg`,
  address: {
    streetAddress: 'Carlos Quijano 1288 bis 2901',
    addressLocality: 'Montevideo',
    addressRegion: 'Ciudad Vieja',
    addressCountry: 'UY',
  },
  priceRange: '$$$',
  sameAs: [
    'https://www.instagram.com/dianasaraviagallery/',
    'https://www.tripadvisor.com/Attraction_Review-g294323-d12149047-Reviews-Galeria_Diana_Saravia-Montevideo_Montevideo_Department.html',
    'https://www.estearte.com/dianasaravia',
  ],
});

const navLinks = [
  { href: '#diana', label: 'Diana' },
  { href: '#artistas', label: 'Artistas' },
  { href: '#exposiciones', label: 'Exposiciones' },
  { href: '#ferias', label: 'Ferias' },
  { href: '#contacto', label: 'Contacto' },
];
---

<BaseLayout
  title="Diana Saravia · Contemporary Art — Galería de arte uruguayo en Ciudad Vieja"
  description="20 años seleccionando arte uruguayo contemporáneo en Ciudad Vieja. Representamos a más de 15 artistas locales con trayectoria internacional. Visitas con cita previa."
>
  <ScrollProgress />
  <Nav
    brand="Diana Saravia"
    links={navLinks}
    cta={{ href: '#contacto', label: 'Agendar visita' }}
  />

  <main id="main">
    <!-- HERO -->
    <Hero
      eyebrow="Ciudad Vieja, Montevideo"
      title="Diana Saravia · Contemporary Art."
      subtitle="20 años seleccionando arte uruguayo contemporáneo en Ciudad Vieja. Representamos a más de 15 artistas locales con trayectoria internacional."
      variant="split"
      imageUrl="/img/hero.svg"
      imageAlt="Sala de la galería con dos obras montadas sobre pared blanca"
    >
      <Magnetic strength={0.18}>
        <Button as="a" href="#contacto" variant="primary" size="lg">Agendar visita</Button>
      </Magnetic>
      <Button as="a" href="#artistas" variant="outline" size="lg">Ver artistas</Button>
    </Hero>

    <!-- MARQUEE: ferias y nombres -->
    <Marquee
      items={[
        'Pinta Miami',
        'ARCOmadrid',
        'Art Lima',
        'Este Arte · Punta del Este',
        'Arte contemporáneo uruguayo',
        '20 años de curaduría',
        'Carlos Quijano 1288',
      ]}
      speed={50}
      variant="outline"
    />

    <!-- DIANA / BIO -->
    <Section id="diana" spacing="lg">
      <Container>
        <div class="grid lg:grid-cols-12 gap-10 items-start">
          <Reveal effect="fade-up" class="lg:col-span-5">
            <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">Diana</p>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl mb-4 leading-tight">
              Curaduría 1-a-1 con dos décadas de oficio.
            </h2>
          </Reveal>
          <Reveal effect="fade-up" class="lg:col-span-7 lg:pl-6">
            <div class="space-y-5 text-lg leading-relaxed opacity-90">
              <p>
                Diana Saravia dirige la galería desde sus inicios en Ciudad Vieja. Su mirada
                construye puentes entre artistas uruguayos consolidados y nuevas generaciones,
                con un trato cercano y personal a cada coleccionista.
              </p>
              <p>
                Asesoramos a coleccionistas, decoradores e instituciones en la búsqueda de obra,
                montaje, embalaje y traslado internacional. La selección que ves es el resultado
                de años de visitas a talleres, ferias y residencias.
              </p>
              <p class="font-display text-2xl text-[var(--color-primary)]">
                "Contacto directo con Diana: agendá una visita."
              </p>
            </div>
            <div class="mt-8 grid sm:grid-cols-3 gap-4 text-sm">
              <div class="border-l-2 border-[var(--color-accent)] pl-4">
                <p class="font-display text-3xl text-[var(--color-primary)]">20+</p>
                <p class="opacity-70">Años de trayectoria</p>
              </div>
              <div class="border-l-2 border-[var(--color-accent)] pl-4">
                <p class="font-display text-3xl text-[var(--color-primary)]">15+</p>
                <p class="opacity-70">Artistas representados</p>
              </div>
              <div class="border-l-2 border-[var(--color-accent)] pl-4">
                <p class="font-display text-3xl text-[var(--color-primary)]">4</p>
                <p class="opacity-70">Ferias internacionales por año</p>
              </div>
            </div>
          </Reveal>
        </div>
      </Container>
    </Section>

    <!-- ARTISTAS REPRESENTADOS -->
    <Section id="artistas" spacing="lg" background="muted">
      <Container>
        <Reveal effect="fade-up">
          <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">Artistas</p>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl mb-4 max-w-3xl leading-tight">
            Representamos a más de 15 artistas locales con trayectoria internacional.
          </h2>
          <p class="max-w-2xl text-lg opacity-80 mb-10">
            Una selección de la nómina representada por la galería. Para ver obra disponible de
            cada artista, agendá una visita o escribinos directamente.
          </p>
          <p class="text-sm opacity-60 mb-10 italic">
            {`{{PENDIENTE_LISTA_ARTISTAS_REPRESENTADOS}}`} · {`{{PENDIENTE_DERECHOS_DE_IMAGEN_DE_OBRAS}}`}
          </p>
        </Reveal>
        <Reveal effect="blur" stagger>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
            {artists.map((a) => (
              <Tilt intensity={4} glare={false}>
                <ArtistCard
                  name={a.name}
                  imageUrl={a.imageUrl}
                  imageAlt={a.imageAlt}
                  representedSince={a.representedSince}
                  discipline={a.discipline}
                />
              </Tilt>
            ))}
          </div>
        </Reveal>
      </Container>
    </Section>

    <!-- EXPOSICIONES / VISITAS -->
    <Section id="exposiciones" spacing="lg">
      <Container>
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <Reveal effect="fade-right">
            <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">Exposiciones</p>
            <h2 class="font-display text-3xl sm:text-4xl mb-4 leading-tight">
              Visitas con cita previa en Ciudad Vieja y Centro.
            </h2>
            <p class="text-lg opacity-80 mb-6">
              La galería opera con agenda — preferimos recibirte con tiempo, sin público en paralelo,
              para que veas la obra como corresponde. Trabajamos con dos sedes activas en Montevideo.
            </p>
            <div class="space-y-6">
              <div class="border-l-2 border-[var(--color-accent)] pl-5">
                <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-1">Sede principal</p>
                <p class="font-display text-2xl">Carlos Quijano 1288 bis 2901</p>
                <p class="opacity-80">Ciudad Vieja, Montevideo</p>
              </div>
              <div class="border-l-2 border-[var(--color-accent)] pl-5">
                <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-1">Sede 2 · Club de París</p>
                <p class="font-display text-2xl">San José 876</p>
                <p class="opacity-80">Centro, Montevideo</p>
              </div>
            </div>
            <p class="mt-6 opacity-80">
              "Visitas con cita previa en Carlos Quijano 1288 o Club de París, San José 876."
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Magnetic strength={0.18}>
                <Button as="a" href="#contacto" variant="primary" size="lg">Agendar visita</Button>
              </Magnetic>
              <Button as="a" href={waLink} variant="outline" size="lg" rel="noopener noreferrer" target="_blank">
                Escribirnos por WhatsApp
              </Button>
            </div>
          </Reveal>
          <Reveal effect="fade-left">
            <Parallax intensity={0.25}>
              <MapEmbed query="Carlos Quijano 1288, Ciudad Vieja, Montevideo, Uruguay" height={460} />
            </Parallax>
          </Reveal>
        </div>
      </Container>
    </Section>

    <!-- FERIAS -->
    <Section id="ferias" spacing="lg" background="muted">
      <Container size="md">
        <Reveal effect="fade-up">
          <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">Ferias internacionales</p>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl mb-4 leading-tight">
            Participamos en ferias en Miami, Madrid, Lima y Punta del Este.
          </h2>
          <p class="max-w-2xl text-lg opacity-80 mb-10">
            Cronología reciente de la galería en circuitos internacionales y de temporada.
          </p>
        </Reveal>
        <Reveal effect="fade-up">
          <FairsList fairs={fairs} />
        </Reveal>
        <p class="mt-10 text-sm opacity-60 italic">
          {`{{VERIFICAR_FECHAS_FERIAS}}`} — los detalles definitivos se confirman con la galería.
        </p>
      </Container>
    </Section>

    <!-- ASESORAMIENTO / CTA INTERMEDIO -->
    <Section spacing="md">
      <Container size="md">
        <Reveal effect="fade-up">
          <div class="text-center">
            <p class="font-display text-2xl sm:text-3xl lg:text-4xl leading-snug max-w-3xl mx-auto">
              "Asesoramiento a coleccionistas, decoradores e instituciones."
            </p>
            <p class="mt-6 opacity-75 max-w-xl mx-auto">
              Acompañamos compras únicas, conformación de colecciones privadas e instalaciones
              para espacios corporativos. Tasaciones y curaduría a medida.
            </p>
          </div>
        </Reveal>
      </Container>
    </Section>

    <!-- CONTACTO -->
    <Section id="contacto" spacing="lg" background="accent">
      <Container size="md">
        <Reveal effect="fade-up">
          <p class="text-sm uppercase tracking-widest text-[var(--color-secondary)] mb-2">Contacto</p>
          <h2 class="font-display text-3xl sm:text-4xl mb-2 leading-tight">
            Contacto directo con Diana: agendá una visita.
          </h2>
          <p class="opacity-80 mb-8 max-w-xl">
            Contanos qué te interesa — una visita a la galería, una obra puntual, una colaboración
            o una nota de prensa — y te respondemos a la brevedad.
          </p>
        </Reveal>
        <Reveal effect="fade-up">
          <VisitForm />
        </Reveal>
      </Container>
    </Section>
  </main>

  <Footer
    brand="Diana Saravia · Contemporary Art"
    tagline="20 años seleccionando arte uruguayo contemporáneo en Ciudad Vieja."
    address="Carlos Quijano 1288 bis 2901, Ciudad Vieja, Montevideo · Sede 2: San José 876, Centro"
    phone="+598 99 14 93 89"
    email="galeriadianasaravia@gmail.com"
    social={[
      { href: 'https://www.instagram.com/dianasaraviagallery/', label: 'Instagram' },
      { href: 'https://www.tripadvisor.com/Attraction_Review-g294323-d12149047-Reviews-Galeria_Diana_Saravia-Montevideo_Montevideo_Department.html', label: 'Tripadvisor' },
    ]}
    legal={[
      { href: '/legal/privacidad', label: 'Privacidad' },
      { href: '/legal/terminos', label: 'Términos' },
      { href: '/legal/cookies', label: 'Cookies' },
    ]}
  />

  <WhatsAppFloat number={WHATSAPP} message={WHATSAPP_MSG} />
  <JsonLd data={schema} />
</BaseLayout>
