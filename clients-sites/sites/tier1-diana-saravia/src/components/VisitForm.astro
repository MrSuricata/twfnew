---
import { FormField } from '@twf/ui';

interface Props {
  action?: string;
  successMessage?: string;
  errorMessage?: string;
  submitLabel?: string;
  class?: string;
}
const {
  action = '/api/contact',
  successMessage = 'Gracias. Diana se pondrá en contacto a la brevedad.',
  errorMessage = 'No pudimos enviar el mensaje. Probá de nuevo.',
  submitLabel = 'Enviar consulta',
  class: className = '',
} = Astro.props;
---

<form
  action={action}
  method="post"
  class={`grid gap-4 ${className}`}
  data-contact-form
  novalidate
>
  <FormField id="vf-name" name="name" label="Nombre" type="text" required autocomplete="name" />
  <FormField id="vf-email" name="email" label="Email" type="email" required autocomplete="email" />
  <FormField id="vf-phone" name="phone" label="Teléfono (opcional)" type="tel" autocomplete="tel" />
  <FormField
    id="vf-subject"
    name="subject"
    label="Interés"
    type="select"
    required
    options={[
      { value: '', label: 'Elegí una opción' },
      { value: 'visita', label: 'Visita a la galería' },
      { value: 'obra', label: 'Consulta por una obra específica' },
      { value: 'colaboracion', label: 'Colaboración / curaduría' },
      { value: 'prensa', label: 'Prensa / comunicación' },
    ]}
  />
  <FormField
    id="vf-message"
    name="message"
    label="Mensaje"
    type="textarea"
    required
    helperText="Contanos brevemente qué te interesa y, si querés, una fecha tentativa para la visita."
  />
  <!-- Honeypot anti-bot -->
  <FormField id="vf-website" name="website" label="Sitio web (no completar)" type="text" hidden ariaLabel="Honeypot" />

  <button
    type="submit"
    class="inline-flex items-center justify-center rounded-md bg-[var(--color-primary)] text-[var(--color-primary-contrast,white)] px-5 py-3 font-medium hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-primary)] disabled:opacity-60 transition-opacity"
    data-submit
  >
    {submitLabel}
  </button>

  <p class="text-sm hidden" aria-live="polite" data-status data-ok={successMessage} data-err={errorMessage}></p>
</form>

<script is:inline>
  (function () {
    const init = () => {
      document.querySelectorAll('[data-contact-form]:not([data-ready])').forEach((form) => {
        form.setAttribute('data-ready', 'true');
        const submitBtn = form.querySelector('[data-submit]');
        const status = form.querySelector('[data-status]');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!submitBtn || !status) return;
          const original = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Enviando…';
          status.classList.add('hidden');
          try {
            const fd = new FormData(form);
            const res = await fetch(form.action, {
              method: 'POST',
              body: fd,
              headers: { Accept: 'application/json' },
            });
            const ok = res.ok;
            status.textContent = ok ? status.dataset.ok : status.dataset.err;
            status.className = `text-sm ${ok ? 'text-green-700' : 'text-red-700'}`;
            if (ok) form.reset();
          } catch (err) {
            status.textContent = status.dataset.err;
            status.className = 'text-sm text-red-700';
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = original;
          }
        });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
