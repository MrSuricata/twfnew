---
interface Props {
  as?: 'a' | 'button';
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  fullWidth?: boolean;
  ariaLabel?: string;
  rel?: string;
  target?: string;
  class?: string;
  disabled?: boolean;
}

const {
  as = 'a',
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  fullWidth = false,
  ariaLabel,
  rel,
  target,
  class: className = '',
  disabled = false,
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium rounded-md transition-colors duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed';

const sizes = {
  sm: 'text-sm px-3 py-1.5 gap-1.5',
  md: 'text-base px-4 py-2.5 gap-2',
  lg: 'text-lg px-6 py-3 gap-2',
};

const variants = {
  primary:
    'bg-[var(--color-primary)] text-[var(--color-primary-contrast,white)] hover:opacity-90 focus-visible:ring-[var(--color-primary)]',
  secondary:
    'bg-[var(--color-secondary)] text-[var(--color-secondary-contrast,white)] hover:opacity-90 focus-visible:ring-[var(--color-secondary)]',
  outline:
    'border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)]/10 focus-visible:ring-[var(--color-primary)]',
  ghost:
    'text-[var(--color-neutral-text)] hover:bg-black/5 focus-visible:ring-[var(--color-neutral-text)]',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${fullWidth ? 'w-full' : ''} ${className}`;
---

{
  as === 'a' ? (
    <a
      href={href}
      class={classes}
      aria-label={ariaLabel}
      rel={rel}
      target={target}
      aria-disabled={disabled || undefined}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
}
