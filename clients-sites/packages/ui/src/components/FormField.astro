---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'number' | 'date' | 'select';
  placeholder?: string;
  required?: boolean;
  rows?: number;
  options?: { value: string; label: string }[];
  autocomplete?: string;
  helperText?: string;
  defaultValue?: string;
  class?: string;
  hidden?: boolean;
  ariaLabel?: string;
}
const {
  id,
  name,
  label,
  type = 'text',
  placeholder,
  required = false,
  rows = 5,
  options = [],
  autocomplete,
  helperText,
  defaultValue,
  class: className = '',
  hidden = false,
  ariaLabel,
} = Astro.props;
const helperId = helperText ? `${id}-helper` : undefined;
const baseInput =
  'w-full rounded-md border border-black/15 bg-white px-3 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-shadow';
---

<div class={`flex flex-col gap-1.5 ${hidden ? 'sr-only absolute -left-[9999px]' : ''} ${className}`}>
  <label for={id} class="text-sm font-medium">
    {label}
    {required && <span class="text-red-600" aria-hidden="true"> *</span>}
  </label>
  {type === 'textarea' && (
    <textarea
      id={id}
      name={name}
      placeholder={placeholder}
      required={required}
      rows={rows}
      autocomplete={autocomplete}
      aria-describedby={helperId}
      aria-label={ariaLabel}
      class={baseInput}
    >{defaultValue}</textarea>
  )}
  {type === 'select' && (
    <select
      id={id}
      name={name}
      required={required}
      autocomplete={autocomplete}
      aria-describedby={helperId}
      aria-label={ariaLabel}
      class={baseInput}
    >
      {options.map((o) => (
        <option value={o.value} selected={defaultValue === o.value}>{o.label}</option>
      ))}
    </select>
  )}
  {type !== 'textarea' && type !== 'select' && (
    <input
      id={id}
      name={name}
      type={type}
      placeholder={placeholder}
      required={required}
      autocomplete={autocomplete}
      aria-describedby={helperId}
      aria-label={ariaLabel}
      value={defaultValue}
      class={baseInput}
    />
  )}
  {helperText && (
    <p id={helperId} class="text-xs opacity-70">{helperText}</p>
  )}
</div>
