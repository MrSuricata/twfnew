---
interface Props {
  as?: string;
  href?: string;
  variant?: 'default' | 'bordered' | 'glass' | 'elevated';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
}
const {
  as: Tag = 'article',
  href,
  variant = 'default',
  padding = 'md',
  class: className = '',
} = Astro.props;
const variants = {
  default: 'bg-white border border-black/5',
  bordered: 'bg-transparent border border-[var(--color-neutral-text)]/15',
  glass: 'bg-white/60 backdrop-blur border border-white/40',
  elevated: 'bg-white shadow-md hover:shadow-lg transition-shadow duration-300',
};
const paddings = { none: '', sm: 'p-4', md: 'p-6', lg: 'p-8' };
const classes = `rounded-xl overflow-hidden ${variants[variant]} ${paddings[padding]} ${className}`;
---

{href ? (
  <a href={href} class={`${classes} block group`}>
    <slot />
  </a>
) : (
  <Tag class={classes}>
    <slot />
  </Tag>
)}
