---
interface Props {
  as?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'prose';
  class?: string;
}
const { as: Tag = 'div', size = 'lg', class: className = '' } = Astro.props;
const sizes = {
  sm: 'max-w-2xl',
  md: 'max-w-4xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  prose: 'max-w-prose',
};
---

<Tag class={`mx-auto w-full px-5 sm:px-6 lg:px-8 ${sizes[size]} ${className}`}>
  <slot />
</Tag>
