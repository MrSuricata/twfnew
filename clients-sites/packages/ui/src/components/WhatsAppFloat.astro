---
import { buildWhatsAppLink } from '@twf/lib/whatsapp';

interface Props {
  number: string;
  message?: string;
  label?: string;
  position?: 'bottom-right' | 'bottom-left';
  showLabel?: boolean;
  class?: string;
}
const {
  number,
  message,
  label = 'Escribinos por WhatsApp',
  position = 'bottom-right',
  showLabel = true,
  class: className = '',
} = Astro.props;
const href = buildWhatsAppLink({ number, message });
const posClass = position === 'bottom-left' ? 'left-4 sm:left-6' : 'right-4 sm:right-6';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class={`fixed bottom-4 sm:bottom-6 ${posClass} z-[1250] group inline-flex items-center gap-3 rounded-full bg-[#25D366] text-white shadow-lg hover:shadow-xl transition-all duration-300 ease-out hover:-translate-y-0.5 ${className}`}
  style="padding: 0.75rem 1rem;"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A11.86 11.86 0 0012.04 0C5.46 0 .1 5.36.1 11.94c0 2.1.55 4.16 1.6 5.97L0 24l6.27-1.65a11.93 11.93 0 005.77 1.47h.01c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.18-3.47-8.4zM12.05 21.8h-.01a9.84 9.84 0 01-5.02-1.38l-.36-.22-3.72.98 1-3.63-.23-.37a9.79 9.79 0 01-1.51-5.24c0-5.42 4.41-9.83 9.83-9.83 2.62 0 5.09 1.02 6.95 2.88a9.74 9.74 0 012.88 6.96c0 5.42-4.41 9.83-9.81 9.83zm5.4-7.36c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.66.15-.2.3-.76.97-.93 1.17-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.34.45-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.18-.24-.57-.49-.5-.66-.51-.17-.01-.37-.01-.57-.01s-.52.07-.79.37c-.27.3-1.04 1.02-1.04 2.47s1.07 2.86 1.22 3.06c.15.2 2.1 3.21 5.08 4.5.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.34z"></path>
  </svg>
  {showLabel && (
    <span class="hidden sm:inline-block text-sm font-medium pr-1">WhatsApp</span>
  )}
</a>
