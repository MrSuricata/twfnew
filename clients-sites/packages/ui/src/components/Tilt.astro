---
/**
 * Tilt 3D sutil sobre hover. JS-light: usa eventos pointer y CSS variables.
 * Respeta prefers-reduced-motion.
 */
interface Props {
  intensity?: number;
  perspective?: number;
  glare?: boolean;
  class?: string;
  as?: string;
}
const {
  intensity = 8,
  perspective = 900,
  glare = true,
  class: className = '',
  as: Tag = 'div',
} = Astro.props;
---

<Tag
  class={`tilt ${className}`}
  data-tilt
  data-tilt-intensity={intensity}
  data-tilt-glare={glare ? 'true' : 'false'}
  style={`--tilt-perspective:${perspective}px;`}
>
  <div class="tilt__inner">
    <slot />
    {glare && <span class="tilt__glare" aria-hidden="true"></span>}
  </div>
</Tag>

<style>
  .tilt {
    perspective: var(--tilt-perspective, 900px);
    transform-style: preserve-3d;
  }
  .tilt__inner {
    position: relative;
    transform: rotateX(var(--tilt-rx, 0deg)) rotateY(var(--tilt-ry, 0deg)) scale(var(--tilt-scale, 1));
    transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .tilt__glare {
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--tilt-mx, 50%) var(--tilt-my, 50%),
      rgba(255, 255, 255, 0.35),
      transparent 45%
    );
    opacity: var(--tilt-glare, 0);
    transition: opacity 200ms ease;
    mix-blend-mode: overlay;
  }
  @media (prefers-reduced-motion: reduce) {
    .tilt__inner { transform: none !important; transition: none; }
    .tilt__glare { opacity: 0 !important; }
  }
</style>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const init = () => {
      document.querySelectorAll('[data-tilt]:not([data-tilt-ready])').forEach((el) => {
        el.setAttribute('data-tilt-ready', 'true');
        const intensity = parseFloat(el.getAttribute('data-tilt-intensity') || '8');
        const enableGlare = el.getAttribute('data-tilt-glare') === 'true';
        const onMove = (e) => {
          const rect = el.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          const rx = (0.5 - y) * intensity;
          const ry = (x - 0.5) * intensity;
          el.style.setProperty('--tilt-rx', rx.toFixed(2) + 'deg');
          el.style.setProperty('--tilt-ry', ry.toFixed(2) + 'deg');
          el.style.setProperty('--tilt-scale', '1.015');
          if (enableGlare) {
            el.style.setProperty('--tilt-mx', (x * 100).toFixed(1) + '%');
            el.style.setProperty('--tilt-my', (y * 100).toFixed(1) + '%');
            el.style.setProperty('--tilt-glare', '0.6');
          }
        };
        const reset = () => {
          el.style.setProperty('--tilt-rx', '0deg');
          el.style.setProperty('--tilt-ry', '0deg');
          el.style.setProperty('--tilt-scale', '1');
          if (enableGlare) el.style.setProperty('--tilt-glare', '0');
        };
        el.addEventListener('pointermove', onMove);
        el.addEventListener('pointerleave', reset);
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
